\par }{\f242\insrsid13253995\charrsid13253995 Gi\'e1m \'f0}{\f0\insrsid13253995\charrsid13253995 \u7889\'3fc H\u7843\'3fi quan t\u7881\'3fnh ch\u7883\'3fu tr\'e1ch nhi\u7879\'3f}{\f250\insrsid13253995\charrsid13253995 m tr\'fd}{
