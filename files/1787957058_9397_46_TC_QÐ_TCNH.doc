\par \tab C\'a8n c\'f8 Ngh\'de \'ae\'denh s\'e8 15/CP ng\'b5y 2/3/1993 c\'f1a Ch\'ddnh ph\'f1 v\'d2 nhi\'d6m v\'f4, quy\'d2n h\'b9n v\'b5 tr\'b8ch nhi\'d6m qu\'b6n l\'fd Nh\'b5 n\'ad\'edc c\'f1a B\'e9, c\'ac quan ngang B\'e9;
\par 
\par \tab C\'a8n c\'f8 Ngh\'de \'ae\'denh s\'e8 178/CP ng\'b5y 28/10/1994 c\'f1a Ch\'ddnh ph\'f1 v\'d2 nhi\'d6m v\'f4, quy\'d2n h\'b9n v\'b5 t\'e6 ch\'f8c b\'e9 m\'b8y B\'e9 T\'b5i ch\'ddnh;
\par 
\par \tab Th\'f9c hi\'d6n ch\'f1 tr\'ad\'acng c\'f1a Ch\'ddnh ph\'f1 t\'b9i c\'abng v\'a8n s\'e8 3296/KTTH ng\'b5y 6/7/1993 c\'f1a V\'a8n ph\'dfng Ch\'ddnh ph\'f1 cho ph\'d0p th\'dd \'aei\'d3m l\'b9i h\'d7nh x\'e6 s\'e8 " Bi\'d5t k\'d5t qu\'b6 ngay ";
\par 
\par \tab Theo \'ae\'d2 ngh\'de c\'f1a U\'fb ban nh\'a9n d\'a9n c\'b8c t\'d8nh L\'b5o cai, V\'dcnh ph\'f3, H\'b6i h\'adng, Lai ch\'a9u, Ho\'b5 b\'d7nh, Thanh ho\'b8, Ngh\'d6 an, B\'bec th\'b8i v\'b5 V\'f4 tr\'ad\'ebng V\'f4 T\'b5i ch\'ddnh c\'b8c Ng\'a9n h\'b5
ng v\'b5 T\'e6 ch\'f8c t\'b5i ch\'ddnh.
\par 
\par 
\par }\pard \qc \li630\ri1709\sl240\slmult0\widctlpar\tx1350\tx2070\tx2790\tx3510\tx4230\tx4950\tx5670\tx6390\tx7110\tx7830\tx8550\tx9270\tx9990\tx10710\faauto\adjustright\rin1709\lin630\itap0 {\b\f0\fs24\cf1\cgrid0\insrsid10308709\charrsid15749126 QUY\u7870
