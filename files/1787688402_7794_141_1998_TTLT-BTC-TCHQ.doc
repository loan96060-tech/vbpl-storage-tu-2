\par }\pard \qj \fi567\li0\ri0\sa120\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\f0\insrsid5586508\charrsid5586508 
\par }\pard \qc \li0\ri0\sa120\keepn\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\f0\fs20\expnd4\expndtw24\insrsid5586508\charrsid5586508 DANH M\u7908\'3fC B\'c1O C\'c1O T\u7892\'3fNG H\u7906\'3f}{
\b\f38\fs20\expnd4\expndtw24\insrsid5586508\charrsid5586508 P \'d0}{\b\f0\fs20\expnd4\expndtw24\insrsid5586508\charrsid5586508 \u7882\'3fNH K\u7922\'3f
\par }\pard \qc \li0\ri0\sa120\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\f0\insrsid5586508\charrsid5586508 T\u7893\'3fng c\u7909\'3fc H\u7843\'3fi quan cung c\u7845\'3fp cho B\u7897\'3f T\'e0i ch\'ednh
\par }\pard \qj \fi567\li0\ri0\sa120\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\f0\insrsid5586508\charrsid5586508 
\par 1. B\'e1o c\'e1o nhanh s\u7889\'3f}{\f38\insrsid5586508\charrsid5586508  thu \'f0}{\f0\insrsid5586508\charrsid5586508 \u7883\'3fnh k\u7923\'3f 10 ng\'e0y, 20 ng\'e0y, 30 ng\'e0y.
\par 2. B\'e1o c\'e1o s\u7889\'3f n\u7897\'3fp Kho b\u7841\'3fc theo th\'e1ng.
\par 3. B\'e1o c\'e1o s\u7889\'3f n\u7907\'3f thu\u7871\'3f theo th\'e1ng.
\par 4. B\'e1o c\'e1o nh\u7853\'3fp kh\u7849\'3f}{\f46\insrsid5586508\charrsid5586508 u h\'e0ng c\'e2n \'f0}{\f0\insrsid5586508\charrsid5586508 \u7889\'3fi l\u7899\'3fn theo th\'e1ng. 
\par }{\f46\insrsid5586508\charrsid5586508 5. B\'e1o c\'e1o h\'e0ng li\'ean doanh \'f0}{\f0\insrsid5586508\charrsid5586508 \u7847\'3f}{\f46\insrsid5586508\charrsid5586508 u t\'fd XNK theo th\'e1ng.
\par }{\f0\insrsid5586508\charrsid5586508 6. B\'e1o c\'e1o kim ng\u7841\'3fch XNK theo B\u7897\'3f,}{\f46\insrsid5586508\charrsid5586508  Ng\'e0nh, \'d0}{\f0\insrsid5586508\charrsid5586508 \u7883\'3f}{\f46\insrsid5586508\charrsid5586508 a ph\'fd\'f5ng.
\par }{\f0\insrsid5586508\charrsid5586508 7. B\'e1o c\'e1o th\u7889\'3f}{\f46\insrsid5586508\charrsid5586508 ng k\'ea h\'e0ng h\'f3a XNK \'f0}{\f0\insrsid5586508\charrsid5586508 \u7883\'3fnh k\u7923\'3f 10 ng\'e0y, 20 ng\'e0y, 30 ng\'e0y.
\par 8. B\'e1o c\'e1o XNK c\'e1c m\u7863\'3ft h\'e0ng ch\u7911\'3f y\u7871\'3fu theo th\'e1ng.
\par 9. B\'e1o c\'e1o nh\u7853\'3fp kh\u7849\'3f}{\f46\insrsid5586508\charrsid5586508 u h\'e0ng ti\'eau d\'f9ng Nh\'e0 n\'fd}{\f0\insrsid5586508\charrsid5586508 \u7899\'3fc qu\u7843\'3fn l\'fd.
\par 10. B\'e1o c\'e1o t\u7893\'3fng h\u7907\'3fp t\'ecnh h\'ecnh ch\u7889\'3fng bu\'f4n l\u7853\'3fu theo qu\'ed.
\par }\pard \ql \li0\ri0\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\f0\insrsid5586508\charrsid5586508 
\par }}