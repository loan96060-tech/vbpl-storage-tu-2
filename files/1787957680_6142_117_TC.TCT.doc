\par d. X\u7917\'3f ph\u7841\'3ft theo quy \'f0\u7883\'3fnh \'f0\u7889\'3fi v\u7899\'3fi t\u7915\'3fng tr\'fd\u7901\'3fng h\u7907\'3fp vi ph\u7841\'3fm ch\u7871\'3f \'f0\u7897\'3f thu, n\u7897\'3fp l\u7879\'3f ph\'ed giao th\'f4ng theo h\'fd\u7899\'3fng d
\u7851\'3fn t\u7841\'3fi Th\'f4ng t\'fd n\'e0y.
\par }\pard \ltrpar\qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\wrapdefault\faauto\adjustright\rin0\lin0\itap0\pararsid13899640 {\rtlch\fcs1 
