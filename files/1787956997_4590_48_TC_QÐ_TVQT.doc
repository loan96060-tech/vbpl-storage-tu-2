\par \tab C\'a8n c\'f8 Ngh\'de \'ae\'denh s\'e8 178/CP ng\'b5y 28/10/1994 c\'f1a Ch\'ddnh ph\'f1 v\'d2 nhi\'d6m v\'f4, quy\'d2n h\'b9n v\'b5 t\'e6 ch\'f8c b\'e9 m\'b8y B\'e9 T\'b5i ch\'ddnh;
\par \tab C\'a8n c\'f8 c\'abng v\'a8n s\'e8 204/CV-TU ng\'b5y 16/12/1994 c\'f1a T\'d8nh u\'fb Qu\'b6ng nam - \'a7\'b5 n\'bdng ( Ban T\'e6 ch\'f8c T\'d8nh u\'fb ) th\'abng b\'b8o H\'e9i \'ae\'e5ng Nh\'a9n d\'a9n kho\'b8 V \'ae\'b7 b\'c7u \'ae\'e5ng ch\'dd Hu
\'fanh N\'a8m C\'f4c tr\'ad\'ebng C\'f4c thu\'d5 T\'d8nh l\'b5m Ph\'e3 Ch\'f1 t\'dech UBND T\'d8nh nhi\'d6m k\'fa 1994 - 1999;
\par \tab X\'d0t nhu c\'c7u c\'abng t\'b8c;
\par \tab Theo \'ae\'d2 ngh\'de c\'f1a \'ae\'e5ng ch\'dd T\'e6ng c\'f4c tr\'ad\'ebng T\'e6ng c\'f4c thu\'d5, V\'f4 tr\'ad\'ebng V\'f4 T\'e6 ch\'f8c c\'b8n b\'e9 v\'b5 \'a7\'b5o t\'b9o;
