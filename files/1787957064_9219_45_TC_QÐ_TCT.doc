\par }{\f0\fs24\cf1\cgrid0\insrsid13461383\charrsid13461383 \tab C\'a8n c\'f8 kho\'b6n 2, \'a7i\'d2u 1 c\'f1a Lu\'cbt s\'f6a \'ae\'e6i, b\'e6 sung m\'e9t s\'e8 \'aei\'d2u c\'f1a Lu\'cbt thu\'d5 doanh thu; \'a7i\'d2u 12, Ngh\'de \'ae\'denh 55/CP ng\'b5
y 28/8/1993 c\'f1a Ch\'ddnh ph\'f1 quy \'ae\'denh chi ti\'d5t thi h\'b5nh Lu\'cbt thu\'d5 doanh thu v\'b5 Lu\'cbt s\'f6a \'ae\'e6i, b\'e6 sung m\'e9t s\'e8 \'aei\'d2u c\'f1a Lu\'cbt thu\'d5 doanh thu;
\par 
\par \tab C\'a8n c\'f8 c\'b8c quy \'ae\'denh v\'d2 th\'c8m quy\'d2n v\'b5 th\'f1 t\'f4c x\'d0t gi\'b6m thu\'d5 doanh thu t\'b9i Th\'abng t\'ad s\'e8 73A TC/TCT ng\'b5y 30/8/1993 c\'f1a B\'e9 T\'b5i ch\'ddnh h\'ad\'edng d\'c9n thi h\'b5nh Ngh\'de \'ae\'denh s
\'e8 55/CP ( n\'aau tr\'aan ) c\'f1a Ch\'ddnh ph\'f1;
\par 
\par \tab X\'d0t h\'e5 s\'ac xin gi\'b6m thu\'d5 doanh thu c\'f1a C\'ac s\'eb s\'b6n xu\'cat Nh\'cbt Th\'denh v\'b5 \'ae\'d2 ngh\'de x\'d0t gi\'b6m thu\'d5 doanh thu cho c\'ac s\'eb s\'b6n xu\'cat m\'edi th\'b5nh l\'cbp t\'b9i c\'abng v\'a8n s\'e8
 4286/CT-Ng.V ng\'b5y 22/12/1994 c\'f1a C\'f4c thu\'d5 th\'b5nh ph\'e8 H\'e5 Ch\'dd Minh.
\par 
