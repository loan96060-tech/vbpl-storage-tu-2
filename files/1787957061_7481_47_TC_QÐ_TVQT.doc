\par \tab C\'a8n c\'f8 Ngh\'de \'ae\'denh s\'e8 15/CP ng\'b5y 2/3/1993 c\'f1a Ch\'ddnh ph\'f1 v\'d2 nhi\'d6m v\'f4, quy\'d2n h\'b9n v\'b5 tr\'b8ch nhi\'d6m qu\'b6n l\'fd Nh\'b5 n\'ad\'edc c\'f1a B\'e9, c\'ac quan ngang B\'e9;
\par 
\par \tab C\'a8n c\'f8 Ngh\'de \'ae\'denh s\'e8 178/CP ng\'b5y 28/10/1994 c\'f1a Ch\'ddnh ph\'f1 v\'d2 nhi\'d6m v\'f4, quy\'d2n h\'b9n v\'b5 t\'e6 ch\'f8c b\'e9 m\'b8y B\'e9 T\'b5i ch\'ddnh;
\par 
\par  \tab C\'a8n c\'f8 v\'b5o Quy\'d5t \'ae\'denh s\'e8 230/TCQT ng\'b5y 22/101994 c\'f1a Ban T\'b5i ch\'ddnh qu\'b6n tr\'de Trung \'ad\'acng v\'b5 bi\'aan b\'b6n cu\'e9c h\'e4p ng\'b5y 25/11/1994 v\'d2 vi\'d6c b\'b5n giao 4 ha \'ae\'cat t\'b9i x\'b7 T\'a8
ng Nh\'acn Ph\'f3, huy\'d6n Th\'f1 \'ae\'f8c, th\'b5nh ph\'e8 H\'e5 Ch\'dd Minh cho B\'e9 T\'b5i ch\'ddnh; \'ae\'d3 x\'a9y d\'f9ng c\'ac s\'eb \'ae\'b5o t\'b9o Tr\'ad\'eang Trung h\'e4c T\'b5i ch\'ddnh k\'d5 to\'b8n IV th\'b5nh ph\'e8 H\'e5 Ch\'dd Minh.

\par 
\par \tab Theo \'ae\'d2 ngh\'de c\'f1a \'ae\'e5ng ch\'dd V\'f4 tr\'ad\'ebng V\'f4 T\'b5i v\'f4 qu\'b6n tr\'de, Ch\'b8nh V\'a8n ph\'dfng b\'e9 T\'b5i ch\'ddnh, Hi\'d6u tr\'ad\'ebng Tr\'ad\'eang Trung h\'e4c T\'b5i ch\'ddnh k\'d5 to\'b8n IV th\'b5nh ph\'e8 H\'e5
 Ch\'dd Minh.
\par 
\par 
\par }\pard \qc \li630\ri1709\sl240\slmult0\widctlpar\tx1350\tx2070\tx2790\tx3510\tx4230\tx4950\tx5670\tx6390\tx7110\tx7830\tx8550\tx9270\tx9990\tx10710\faauto\adjustright\rin1709\lin630\itap0 {\b\f0\fs24\cf1\cgrid0\insrsid3831604\charrsid3831604 QUY\u7870\'3f
