\f206\insrsid10565967\charrsid10565967 \'f0}{\f214\insrsid10565967\charrsid10565967 \'fd}{\f0\insrsid10565967\charrsid10565967 \u7907\'3fc ph\'ea duy\u7879\'3ft, v\'e0 theo d\'f5i qu\u7843\'3fn l\'fd kho\u7843\'3fn vay, tr\u7843\'3f n\u7907\'3f khi }{
\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 \u7871\'3fn h\u7841\'3fn (c\u7843\'3f g\u7889\'3fc v\'e0 l\'e3i).
\par 2.5. C\u7909\'3fc }{\f206\insrsid10565967\charrsid10565967 \'d0\u7847\'3f}{\f0\insrsid10565967\charrsid10565967 u t}{\f214\insrsid10565967\charrsid10565967 \'fd}{\f0\insrsid10565967\charrsid10565967  Ph\'e1t tri\u7875\'3fn n}{
\f214\insrsid10565967\charrsid10565967 \'f5}{\f0\insrsid10565967\charrsid10565967 i c\u7845\'3fp ph\'e1t cho d\u7921\'3f \'e1n c\'f3 tr\'e1ch nhi\u7879\'3fm th\u7921\'3fc hi\u7879\'3fn vi\u7879\'3fc qu\u7843\'3fn l\'fd t\'e0i ch\'ednh, ki\u7875\'3f
m tra, x\'e1c nh\u7853\'3fn kh\u7889\'3fi l}{\f214\insrsid10565967\charrsid10565967 \'fd}{\f0\insrsid10565967\charrsid10565967 \u7907\'3fng th\u7921\'3fc hi\u7879\'3fn }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 
\u7891\'3fng th\u7901\'3fi c\u7845\'3fp ph\'e1t v\u7889\'3fn tr\u7921\'3fc ti\u7871\'3fp cho d\u7921\'3f \'e1n.
