\f214\insrsid10565967\charrsid10565967 \'fd}{\f0\insrsid10565967\charrsid10565967 \u7907\'3fc quy }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 \u7883\'3fnh trong c\'e1c quy\u7871\'3ft }{
\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 \u7883\'3fnh th\'e0nh l\u7853\'3fp Ban qu\u7843\'3fn l\'fd d\u7921\'3f \'e1n c\u7911\'3fa B\u7897\'3f NN PTNT.
\par 1.3. IDA l\'e0 Hi\u7879\'3fp h\u7897\'3fi Ph\'e1t tri\u7875\'3fn Qu\u7889\'3fc t\u7871\'3f.
\par 1.4. D\u7921\'3f \'e1n l\'e0 d\u7921\'3f \'e1n B\u7843\'3fo v\u7879\'3f r\u7915\'3fng v\'e0 Ph\'e1t tri\u7875\'3fn n\'f4ng th\'f4n theo quy\u7871\'3ft }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 \u7883\'3fnh s\u7889
\'3f 693/TTg ng\'e0y 27/8/1997 c\u7911\'3fa Th\u7911\'3f t}{\f214\insrsid10565967\charrsid10565967 \'fd}{\f0\insrsid10565967\charrsid10565967 \u7899\'3fng Ch\'ednh ph\u7911\'3f.
\par 1.5. V\u7889\'3fn vay l\'e0 ngu\u7891\'3fn v\u7889\'3fn IDA cho Ch\'ednh ph\u7911\'3f Vi\u7879\'3ft Nam vay theo Hi\u7879\'3fp }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 \u7883\'3fnh T\'edn d\u7909\'3fng ph\'e1
t tri\u7875\'3fn s\u7889\'3f 2996-VN k\'fd ng\'e0y 8/11/1997 cho d\u7921\'3f \'e1n. 1.6. V\u7889\'3fn vi\u7879\'3fn tr\u7907\'3f l\'e0 ngu\u7891\'3fn v\u7889\'3fn Ch\'ednh ph\u7911\'3f H\'e0 Lan vi\u7879\'3fn tr\u7907\'3f kh\'f4ng ho\'e0n l\u7841\'3f
i cho Ch\'ednh ph\u7911\'3f Vi\u7879\'3ft Nam theo Hi\u7879\'3fp }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 \u7883\'3fnh vi\u7879\'3fn tr\u7907\'3f s\u7889\'3f TF 021604 k\'fd ng\'e0y 8/11/1997 cho d\u7921\'3f \'e1
n. V\u7889\'3fn vi\u7879\'3fn tr\u7907\'3f n\'e0y }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f214\insrsid10565967\charrsid10565967 \'fd}{\f0\insrsid10565967\charrsid10565967 \u7907\'3fc u\u7927\'3f th\'e1c t\u7841\'3fi IDA, v\'e0 }{
\f206\insrsid10565967\charrsid10565967 \'f0}{\f214\insrsid10565967\charrsid10565967 \'fd}{\f0\insrsid10565967\charrsid10565967 \u7907\'3fc gi\u7843\'3fi ng\'e2n t\u7915\'3f IDA.
\par 1.7. C\'e1c Hi\u7879\'3fp }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 \u7883\'3fnh l\'e0 Hi\u7879\'3fp }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 \u7883\'3fnh T\'edn d\u7909
\'3fng Ph\'e1t tri\u7875\'3fn s\u7889\'3f 2996-VN v\'e0 Hi\u7879\'3fp }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 \u7883\'3fnh Vi\u7879\'3fn tr\u7907\'3f kh\'f4ng ho\'e0n l\u7841\'3fi s\u7889\'3f TF 021604 k\'fd gi
