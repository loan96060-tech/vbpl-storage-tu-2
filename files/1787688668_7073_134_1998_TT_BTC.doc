\par }\pard \qc \li0\ri0\sa120\keepn\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\f0\fs20\expnd4\expndtw24\insrsid10565967\charrsid10565967 II. N\u7896\'3fI DUNG CHI C\u7910\'3fA C\'c1C NGU\u7890\'3fN V\u7888\'3fN CHO D\u7920\'3f \'c1N:
\par }\pard \qj \fi567\li0\ri0\sa120\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\f0\insrsid10565967\charrsid10565967 2.1. Ngu\u7891\'3fn v\u7889\'3fn vay IDA
\par - Giao }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 \u7845\'3ft
\par - Ch}{\f214\insrsid10565967\charrsid10565967 \'fd\'f5}{\f0\insrsid10565967\charrsid10565967 ng tr\'ecnh h\u7895\'3f tr\u7907\'3f x\'e3 h\u7897\'3fi - D\u7883\'3fch v\u7909\'3f h\u7895\'3f tr\u7907\'3f n\'f4ng nghi\u7879\'3fp
\par - Qu\u7843\'3fn l\'fd r\u7915\'3fng v\'f9ng }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 \u7879\'3fm
\par - Ph\'e1t tri\u7875\'3fn c}{\f214\insrsid10565967\charrsid10565967 \'f5}{\f0\insrsid10565967\charrsid10565967  s\u7903\'3f h\u7841\'3f t\u7847\'3fng n\'f4ng th\'f4n
\par - Qu\u7843\'3fn l\'fd d\u7921\'3f \'e1n v\'e0 t}{\f206\insrsid10565967\charrsid10565967 \'e3}{\f0\insrsid10565967\charrsid10565967 ng c}{\f214\insrsid10565967\charrsid10565967 \'fd}{\f0\insrsid10565967\charrsid10565967 \u7901\'3fng t\u7893\'3f ch\u7913
\'3fc
\par 2.2. Ngu\u7891\'3fn v\u7889\'3fn vi\u7879\'3fn tr\u7907\'3f
\par - Qu\u7843\'3fn l\'fd v\'f9ng r\u7915\'3fng }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f214\insrsid10565967\charrsid10565967 \'fd}{\f0\insrsid10565967\charrsid10565967 \u7907\'3fc b\u7843\'3fo v\u7879\'3f
\par - K\u7871\'3f ho\u7841\'3fch c\u7897\'3fng }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 \u7891\'3fng
\par - Qu\u7843\'3fn l\'fd d\u7921\'3f \'e1n v\'e0 t}{\f206\insrsid10565967\charrsid10565967 \'e3}{\f0\insrsid10565967\charrsid10565967 ng c}{\f214\insrsid10565967\charrsid10565967 \'fd}{\f0\insrsid10565967\charrsid10565967 \u7901\'3fng t\u7893\'3f ch\u7913
\'3fc
\par 2.3. Ngu\u7891\'3fn v\u7889\'3fn }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 \u7889\'3fi \u7913\'3fng:
\par - Qu\u7843\'3fn l\'fd v\'f9ng r\u7915\'3fng }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f214\insrsid10565967\charrsid10565967 \'fd}{\f0\insrsid10565967\charrsid10565967 \u7907\'3fc b\u7843\'3fo v\u7879\'3f
\par - K\u7871\'3f ho\u7841\'3fch c\u7897\'3fng }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 \u7891\'3fng
\par - Giao }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 \u7845\'3ft
\par - Ch}{\f214\insrsid10565967\charrsid10565967 \'fd\'f5}{\f0\insrsid10565967\charrsid10565967 ng tr\'ecnh h\u7895\'3f tr\u7907\'3f x\'e3 h\u7897\'3fi
\par - D\u7883\'3fch v\u7909\'3f h\u7895\'3f tr\u7907\'3f n\'f4ng nghi\u7879\'3fp
\par - Qu\u7843\'3fn l\'fd r\u7915\'3fng v\'f9ng }{\f206\insrsid10565967\charrsid10565967 \'f0}{\f0\insrsid10565967\charrsid10565967 \u7879\'3fm
\par - Ph\'e1t tri\u7875\'3fn c}{\f214\insrsid10565967\charrsid10565967 \'f5}{\f0\insrsid10565967\charrsid10565967  s\u7903\'3f h\u7841\'3f t\u7847\'3fng n\'f4ng th\'f4n
\par - Qu\u7843\'3fn l\'fd d\u7921\'3f \'e1n v\'e0 t}{\f206\insrsid10565967\charrsid10565967 \'e3}{\f0\insrsid10565967\charrsid10565967 ng c}{\f214\insrsid10565967\charrsid10565967 \'fd}{\f0\insrsid10565967\charrsid10565967 \u7901\'3fng t\u7893\'3f ch\u7913
\'3fc.
\par 2.4. C\'e1c ngu\u7891\'3fn v\u7889\'3fn vay c\u7911\'3fa IDA, v\u7889\'3fn vi\u7879\'3fn tr\u7907\'3f c\u7911\'3fa Ch\'ednh ph\u7911\'3f H\'e0 Lan l\'e0 ngu\u7891\'3fn thu Ng\'e2n s\'e1ch Nh\'e0 n}{\f214\insrsid10565967\charrsid10565967 \'fd}{
\f0\insrsid10565967\charrsid10565967 \u7899\'3fc c\u7911\'3fa Ch\'ednh ph\u7911\'3f Vi\u7879\'3ft Nam. B\u7897\'3f T\'e0i ch\'ednh c\'f3 tr\'e1ch nhi\u7879\'3fm thu v\'e0o NSNN v\'e0 th\'f4ng qua h\u7879\'3f th\u7889\'3fng T\u7893\'3fng c\u7909\'3fc }{
\f206\insrsid10565967\charrsid10565967 \'d0\u7847\'3f}{\f0\insrsid10565967\charrsid10565967 u t}{\f214\insrsid10565967\charrsid10565967 \'fd}{\f0\insrsid10565967\charrsid10565967  Ph\'e1t tri\u7875\'3fn c\u7845\'3fp ph\'e1t cho B\u7897\'3f NN PTNT }{
