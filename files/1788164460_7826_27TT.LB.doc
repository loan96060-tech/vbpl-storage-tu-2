\'3f \'e1n quy ho\u7841\'3fch x\'e2y d\u7921\'3fng do H\u7897\'3fi \'f0\u7891\'3fng B\u7897\'3f tr\'fd\u7903\'3fng quy \'f0\u7883\'3fnh.
\par -C\'e1c B\u7897\'3f, T\u7893\'3fng c\u7909\'3fc... l\'e0 ch\u7911\'3f qu\u7843\'3fn quy ho\u7841\'3fch x\'e2y d\u7921\'3fng c\'e1c \'f0\u7891\'3f \'e1n quy ho\u7841\'3fch x\'e2y d\u7921\'3fng chuy\'ean ng\'e0nh do B\u7897\'3f, T\u7893\'3fng c\u7909\'3f
