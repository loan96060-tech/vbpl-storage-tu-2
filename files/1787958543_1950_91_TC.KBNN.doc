\par }\pard \ltrpar\qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\wrapdefault\faauto\adjustright\rin0\lin0\itap0\pararsid4876514 {\rtlch\fcs1 
\af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid13702230\charrsid3043174 1. Tr\'e1i phi\u7871\'3fu doanh nghi\u7879\'3fp Nh\'e0 n\'fd\u7899\'3fc l\'e0 ch\u7913\'3fng ch\u7881\'3f vay n\u7907\'3f c\'f3}{\rtlch\fcs1 \af78\afs24 \ltrch\fcs0 
\f78\fs28\cgrid0\insrsid13702230\charrsid3043174  k\u7923\'3f h\u7841\'3fn, c\'f3 m\u7879\'3fnh gi\'e1 v\'e0 c\'f3 l\'e3i do doanh nghi\u7879\'3fp Nh\'e0 n}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid13702230\charrsid3043174 \'fd\u7899\'3f
c ph\'e1t h\'e0nh nh\u7857\'3fm vay v\u7889\'3fn \'f0\u7875\'3f \'f0\u7847\'3fu t\'fd m\u7903\'3f r\u7897\'3fng quy m\'f4 s\u7843\'3fn xu\u7845\'3ft kinh doanh v\'e0 \'f0\u7893\'3fi m\u7899\'3fi thi\u7871\'3ft b\u7883\'3f, c\'f4ng ngh\u7879\'3f c\u7911
\'3fa doanh nghi\u7879\'3fp.
\par 2. Tr\'e1i phi\u7871\'3fu doanh nghi\u7879\'3fp Nh\'e0 n\'fd\u7899\'3fc bao g\u7891\'3fm c\'e1c lo\u7841\'3fi k}{\rtlch\fcs1 \af78\afs24 \ltrch\fcs0 \f78\fs28\cgrid0\insrsid13702230\charrsid3043174 \'fd danh v\'e0 v\'f4 danh :
\par }{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid13702230\charrsid3043174 - Tr\'e1i ph}{\rtlch\fcs1 \af78\afs24 \ltrch\fcs0 \f78\fs28\cgrid0\insrsid13702230\charrsid3043174 i\u7871\'3fu k\'fd danh l\'e0 lo\u7841\'3fi tr\'e1i phi\u7871\'3fu c
\'f3 ghi t\'ean c}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid13702230\charrsid3043174 \'f5 quan, \'f0\'f5n v\u7883\'3f, c\'e1 nh\'e2n mua tr\'e1i phi\u7871\'3fu (g\u7885\'3fi t\u7855\'3ft l\'e0 ng\'fd\u7901\'3fi mua tr\'e1i phi\u7871\'3f
u) tr\'ean ch\u7913\'3fng ch\u7881\'3f tr\'e1i phi\u7871\'3fu ho\u7863\'3fc \'f0\'e3ng k}{\rtlch\fcs1 \af78\afs24 \ltrch\fcs0 \f78\fs28\cgrid0\insrsid13702230\charrsid3043174 \'fd t\'ean t\u7841\'3fi c}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 
\f0\fs28\cgrid0\insrsid13702230\charrsid3043174 \'f5 quan ph\'e1t h\'e0nh tr\'e1i phi\u7871\'3fu.
\par - Tr\'e1i phi\u7871\'3fu v\'f4 danh l\'e0 lo\u7841\'3fi tr\'e1i phi\u7871\'3fu kh\'f4ng ghi t\'ean ng\'fd\u7901\'3fi mua tr\'e1i phi\u7871\'3fu tr\'ean ch\u7913\'3fng ch\u7881\'3f tr\'e1i phi\u7871\'3fu ho\u7863\'3fc kh\'f4ng \'f0\'e3ng k}{\rtlch\fcs1 
\af78\afs24 \ltrch\fcs0 \f78\fs28\cgrid0\insrsid13702230\charrsid3043174 \'fd t\'ean t\u7841\'3fi c}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid13702230\charrsid3043174 \'f5 quan ph\'e1t h\'e0nh tr\'e1i phi\u7871\'3fu.
\par 3. Tr\'e1i phi\u7871\'3fu doanh nghi\u7879\'3fp Nh\'e0 n\'fd\u7899\'3fc \'f0\'fd\u7907\'3fc ph\'e1t h\'e0nh d\'fd\u7899\'3fi d\u7841\'3fng ch\u7913\'3fng ch\u7881\'3f tr\'e1i phi\u7871\'3fu ho\u7863\'3fc d\'fd\u7899\'3fi d\u7841\'3fng ghi s\u7893\'3f:

\par - Ch\u7913\'3fng ch\u7881\'3f tr\'e1i phi\u7871\'3fu doanh nghi\u7879\'3fp Nh\'e0 n\'fd\u7899\'3fc do B\u7897\'3f T\'e0i ch\'ednh (C\u7909\'3fc  Kho b\u7841\'3fc Nh\'e0 n\'fd\u7899\'3fc) quy \'f0\u7883\'3fnh m\u7851\'3fu, t\u7893\'3f ch\u7913\'3fc in, qu
\u7843\'3fn l}{\rtlch\fcs1 \af78\afs24 \ltrch\fcs0 \f78\fs28\cgrid0\insrsid13702230\charrsid3043174 \'fd v\'e0 chuy\u7875\'3fn cho doanh nghi\u7879\'3fp Nh\'e0 n}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid13702230\charrsid3043174 \'fd
\u7899\'3fc \'f0\u7875\'3f t\u7893\'3f ch\u7913\'3fc ph\'e1t h\'e0nh. Ch\u7913\'3fng ch\u7881\'3f tr\'e1i phi\u7871\'3fu bao g\u7891\'3fm hai lo\u7841\'3fi:
\par }{\rtlch\fcs1 \af78\afs24 \ltrch\fcs0 \f78\fs28\cgrid0\insrsid13702230\charrsid3043174 + Lo\u7841\'3fi c\'f3 tem l\u7845\'3fy l\'e3i theo }{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid13702230\charrsid3043174 \'f0\u7883\'3fnh k\u7923\'3f 
\'e1p d\u7909\'3fng cho c\'e1c h}{\rtlch\fcs1 \af78\afs24 \ltrch\fcs0 \f78\fs28\cgrid0\insrsid13702230\charrsid3043174 \'ecnh th\u7913\'3fc t\'e1i phi\u7871\'3fu doanh nghi\u7879\'3fp Nh\'e0 n}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 
\f0\fs28\cgrid0\insrsid13702230\charrsid3043174 \'fd\u7899\'3fc c\'f3 quy \'f0\u7883\'3fnh tr\u7843\'3f l}{\rtlch\fcs1 \af78\afs24 \ltrch\fcs0 \f78\fs28\cgrid0\insrsid13702230\charrsid3043174 \'e3i }{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 
\f0\fs28\cgrid0\insrsid13702230\charrsid3043174 \'f0\u7883\'3fnh k\u7923\'3f.
\par }{\rtlch\fcs1 \af78\afs24 \ltrch\fcs0 \f78\fs28\cgrid0\insrsid13702230\charrsid3043174 + Lo\u7841\'3fi kh\'f4ng c\'f3 tem l\u7845\'3fy l\'e3i \'e1p d\u7909\'3fng cho c\'e1c h\'ecnh th\u7913\'3fc tr\'e1i phi\u7871\'3fu doanh nghi\u7879\'3fp Nh\'e0 n}{
\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid13702230\charrsid3043174 \'fd\u7899\'3fc kh\'f4ng quy \'f0\u7883\'3fnh tr\u7843\'3f l}{\rtlch\fcs1 \af78\afs24 \ltrch\fcs0 \f78\fs28\cgrid0\insrsid13702230\charrsid3043174 \'e3i }{\rtlch\fcs1 
\af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid13702230\charrsid3043174 \'f0\u7883\'3fnh k\u7923\'3f (tr\u7843\'3f l}{\rtlch\fcs1 \af78\afs24 \ltrch\fcs0 \f78\fs28\cgrid0\insrsid13702230\charrsid3043174 \'e3i m\u7897\'3ft l\u7847\'3fn khi }{\rtlch\fcs1 
\af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid13702230\charrsid3043174 \'f0\u7871\'3fn h\u7841\'3fn thanh to\'e1n ho\u7863\'3fc tr\u7843\'3f l}{\rtlch\fcs1 \af78\afs24 \ltrch\fcs0 \f78\fs28\cgrid0\insrsid13702230\charrsid3043174 \'e3i ngay khi ph\'e1t h
\'e0nh).
\par }{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid13702230\charrsid3043174 - Tr\'e1i phi\u7871\'3fu doanh nghi\u7879\'3fp Nh\'e0 n\'fd\u7899\'3fc ph\'e1t h\'e0nh d\'fd\u7899\'3fi d\u7841\'3fng ghi s\u7893\'3f l\'e0 h}{\rtlch\fcs1 \af78\afs24 
\ltrch\fcs0 \f78\fs28\cgrid0\insrsid13702230\charrsid3043174 \'ecnh th\u7913\'3fc ph\'e1t h\'e0nh m\'e0 t\'ean c\u7911\'3fa ng}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid13702230\charrsid3043174 \'fd\u7901\'3fi mua tr\'e1i phi\u7871\'3fu 
\'f0\'fd\u7907\'3fc \'f0\'e3ng k}{\rtlch\fcs1 \af78\afs24 \ltrch\fcs0 \f78\fs28\cgrid0\insrsid13702230\charrsid3043174 \'fd t\u7841\'3fi c}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid13702230\charrsid3043174 \'f5 quan ph\'e1t h\'e0nh v\'e0
 ng\'fd\u7901\'3fi mua \'f0\'fd\u7907\'3fc c\u7845\'3fp gi\u7845\'3fy ch\u7913\'3fng nh\u7853\'3fn quy\u7873\'3fn s\u7903\'3f h\u7919\'3fu tr\'e1i phi\u7871\'3fu.
\par 4. Tr\'e1i phi\u7871\'3fu doanh nghi\u7879\'3fp Nh\'e0 n\'fd\u7899\'3fc c\'f3 th\u7901\'3fi h\u7841\'3fn t\u7915\'3f 1 n\'e3m tr\u7903\'3f l\'ean, tu\u7923\'3f thu\u7897\'3fc v\'e0o nhu c\u7847\'3fu s\u7917\'3f d\u7909\'3fng v\'e0 kh\u7843\'3f n\'e3
ng thu h\u7891\'3fi v\u7889\'3fn \'f0\u7875\'3f tr\u7843\'3f n\u7907\'3f c\u7911\'3fa doanh nghi\u7879\'3fp.
\par 5. Tr\'e1i phi\u7871\'3fu doanh nghi\u7879\'3fp  Nh\'e0 n\'fd\u7899\'3fc c\'f3 nhi\u7873\'3fu m\u7879\'3fnh gi\'e1 kh\'e1c nhau, tu\u7923\'3f theo t\u7915\'3fng \'f0\u7907\'3ft ph\'e1t h\'e0nh, \'f0\'fd\u7907\'3fc in s\u7861\'3fn tr\'ean ch\u7913\'3fng ch
\u7881\'3f tr\'e1i phi\u7871\'3fu ho\u7863\'3fc \'f0\'fd\u7907\'3fc ghi tr\'ean gi\u7845\'3fy ch\u7913\'3fng nh\u7853\'3fn s\u7903\'3f h\u7919\'3fu tr\'e1i phi\u7871\'3fu. M\u7913\'3fc m\u7879\'3fnh gi\'e1 t\u7889\'3fi thi\u7875\'3fu c\u7911\'3fa tr\'e1
i phi\u7871\'3fu l\'e0 100.000 \'f0\u7891\'3fng Vi\u7879\'3ft nam. 
\par 6. Tr\'e1i phi\u7871\'3fu doanh nghi\u7879\'3fp Nh\'e0 n\'fd\u7899\'3fc \'f0\'fd\u7907\'3fc ghi thu v\'e0 thanh to\'e1n b\u7857\'3fng \'f0\u7891\'3fng Vi\u7879\'3ft nam . Tr\'fd\u7901\'3fng h\u7907\'3fp mua tr\'e1i phi\u7871\'3fu b\u7857\'3fng v\'e0ng ho
\u7863\'3fc ngo\u7841\'3fi t\u7879\'3f chuy\u7875\'3fn \'f0\u7893\'3fi s\u7869\'3f \'f0\'fd\u7907\'3fc c\'f5 quan ph\'e1t h\'e0nh tr\'e1i phi\u7871\'3fu thu v\'e0ng v\'e0 ngo\u7841\'3fi t\u7879\'3f v\'e0 th\u7921\'3fc hi\u7879\'3fn vi\u7879\'3fc chuy
\u7875\'3fn \'f0\u7893\'3fi sang \'f0\u7891\'3fng Vi\u7879\'3ft nam \'f0\u7875\'3f ghi thu v\'e0 thanh to\'e1n. Vi\u7879\'3fc quy \'f0\u7893\'3fi v\'e0ng v\'e0 ngo\u7841\'3fi t\u7879\'3f sang \'f0\u7891\'3fng Vi\u7879\'3ft nam t\u7841\'3fi th\u7901\'3fi 
\'f0i\u7875\'3fm ph\'e1t h\'e0nh tr\'e1i phi\u7871\'3fu \'f0\'fd\u7907\'3fc th\u7921\'3fc hi\u7879\'3fn nh\'fd sau :
\par - \'d0\u7889\'3fi v\u7899\'3fi v\'e0ng : T\'ednh theo gi\'e1 mua v\'e0o c\u7911\'3fa C\'f4ng ty v\'e0ng b\u7841\'3fc \'f0}{\rtlch\fcs1 \af78\afs24 \ltrch\fcs0 \f78\fs28\cgrid0\insrsid13702230\charrsid3043174 \'e1 qu\'fd qu\u7889\'3fc doanh tr\'ean }{
\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid13702230\charrsid3043174 \'f0\u7883\'3fa b\'e0n t\u7881\'3fnh, th\'e0nh ph\u7889\'3f n\'f5i ph\'e1t h\'e0nh tr\'e1i phi\u7871\'3fu.
\par - \'d0\u7889\'3fi v\u7899\'3fi ngo\u7841\'3fi t\u7879\'3f : T\'ednh theo gi\'e1 mua ngo\u7841\'3fi t\u7879\'3f c\u7911\'3fa Ng\'e2n h\'e0ng ngo\u7841\'3fi th\'fd\'f5ng ho\u7863\'3fc Ng\'e2n h\'e0ng th\'fd\'f5ng m\u7841\'3fi qu\u7889\'3fc doanh tr\'ean 
\'f0\u7883\'3fa b\'e0n t\u7881\'3fnh, th\'e0nh ph\u7889\'3f n\'f5i ph\'e1t h\'e0nh tr\'e1i phi\u7871\'3fu.
