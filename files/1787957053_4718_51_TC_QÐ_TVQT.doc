\par \tab C\'a8n c\'f8 Ngh\'de \'ae\'denh s\'e8 178/CP ng\'b5y 28/10/1994 c\'f1a Ch\'ddnh ph\'f1 v\'d2 nhi\'d6m v\'f4, quy\'d2n h\'b9n v\'b5 t\'e6 ch\'f8c b\'e9 m\'b8y B\'e9 T\'b5i ch\'ddnh;
\par 
\par \tab Theo \'ae\'d2 ngh\'de c\'f1a Ban th\'ad\'eang tr\'f9c H\'e9i \'ae\'e5ng li\'aan k\'d5t ph\'b8t h\'b5nh XSKTc\'b8c t\'d8nh B\'bec Mi\'d2n Trung v\'b5 \'ae\'d2 ngh\'de c\'f1a V\'f4 tr\'ad\'ebng V\'f4 T\'b5i ch\'ddnh c\'b8c ng\'a9n h\'b5ng v\'b5 t\'e6
