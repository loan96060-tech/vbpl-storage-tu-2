\par }{\b\i\f0\ul\cf1\cgrid0\insrsid3555371\charrsid3555371 \'a7i\'d2u 3}{\f0\cf1\cgrid0\insrsid3555371\charrsid3555371 : Th\'eai k\'fa thanh tra : n\'a8m 1993, 1994 v\'b5 t\'d7nh h\'d7nh s\'e8 li\'d6u li\'aan quan \'ae\'d5n tr\'ad\'edc v\'b5 sau th\'eai k\'fa
 thanh tra.
\par 
\par Th\'eai gian ti\'d5n h\'b5nh cu\'e9c thanh tra t\'e8i \'aea l\'b5 60 ng\'b5y k\'d3 t\'f5 khi \'a7o\'b5n b\'bet \'ae\'c7u ti\'d5n h\'b5nh thanh tra t\'b9i c\'b8c \'ae\'acn v\'de,
\par 
\par }{\b\i\f0\ul\cf1\cgrid0\insrsid3555371\charrsid3555371 \'a7i\'d2u 4}{\f0\cf1\cgrid0\insrsid3555371\charrsid3555371 : \'a7o\'b5n thanh tra c\'e3 nhi\'d6m v\'f4, quy\'d2n h\'b9n quy \'ae\'denh t\'b9i \'aei\'d2u 14 m\'f4c II, \'aei\'d2u 31 ch\'ad\'acng IV c
\'f1a Ph\'b8p l\'d6nh thanh tra, \'aei\'d2u 10 ch\'ad\'acng II quy ch\'d5 t\'e6 ch\'f8c ho\'b9t \'ae\'e9ng c\'f1a Thanh tra t\'b5i ch\'ddnh ban h\'b5nh k\'ccm theo Quy\'d5t \'ae\'denh s\'e8 173TC/Q\'a7/TCCB  ng\'b5y 21/5/1991 v\'b5 quy\'d5t \'ae\'denh s
\'e8 374Tc/Q\'a7/TTr ng\'b5y 21/6/1993 c\'f1a B\'e9 tr\'ad\'ebng B\'e9 T\'b5i ch\'ddnh v\'d2 quy ch\'d5 ho\'b9t \'ae\'e9ng c\'f1a \'a7o\'b5n thanh tra T\'b5i ch\'ddnh.
\par 
\par }{\b\i\f0\ul\cf1\cgrid0\insrsid3555371\charrsid3555371 \'a7i\'d2u 5}{\f0\cf1\cgrid0\insrsid3555371\charrsid3555371 : C\'f4c H\'b5ng kh\'abng \tab d\'a9n d\'f4ng Vi\'d6t Nam v\'b5 c\'b8c \'ae\'acn v\'de tr\'f9c thu\'e9c v\'b5 c\'b8 nh\'a9n c\'e3 li\'aa
n quan t\'b9o \'aei\'d2u ki\'d6n thu\'cbn l\'eei cho \'a7o\'b5n Thanh tra th\'adch thi c\'abng v\'f4, b\'b8o c\'b8o \'ae\'c7y \'ae\'f1, k\'dep th\'eai, trung th\'f9c t\'d7nh h\'d7nh s\'e8 li\'d6u, ch\'f8ng t\'f5, s\'e6 s\'b8ch c\'e3 li\'aan quan theo y
\'aau c\'c7u c\'f1a \'a7o\'b5n Thanh tra.
\par 
