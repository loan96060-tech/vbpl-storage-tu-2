\par }\pard\plain \ltrpar\s16\qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\widctlpar\wrapdefault\faauto\adjustright\rin0\lin0\itap0\pararsid791519 \rtlch\fcs1 \ab\af38\afs20\alang1025 \ltrch\fcs0 
