\rtlch\fcs1 \af37\afs26\alang1025 \ltrch\fcs0 \f37\fs26\lang3081\langfe1033\cgrid\langnp3081\langfenp1033 {\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid9331118\charrsid791519 - C\'e1c \'f0\'f5n v\u7883\'3f kinh t\u7871\'3f ngo\'e0i qu\u7889
\'3fc doanh, c\'e1 nh\'e2n c\'f3 n\u7907\'3f ph\u7843\'3fi thu \'f0\u7889\'3fi v\u7899\'3fi doanh nghi\u7879\'3fp Nh\'e0 n\'fd\u7899\'3fc.
\par + Doanh nghi\u7879\'3fp \'f0ang ho\u7841\'3ft \'f0\u7897\'3fng ph\u7843\'3fi tr\u7843\'3f to\'e0n b\u7897\'3f n\u7907\'3f qu\'e1 h\u7841\'3fn s\u7889\'3f \'f0}{\rtlch\fcs1 \af41\afs24 \ltrch\fcs0 \f41\fs28\cgrid0\insrsid9331118\charrsid791519 \'e3 k\'fd x
\'e1c nh}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid9331118\charrsid791519 \u7853\'3fn, s\u7889\'3f ch\'fda k}{\rtlch\fcs1 \af41\afs24 \ltrch\fcs0 \f41\fs28\cgrid0\insrsid9331118\charrsid791519 \'fd ch}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 
\f0\fs28\cgrid0\insrsid9331118\charrsid791519 \u7911\'3f n\u7907\'3f c\u361\'3fng chuy\u7875\'3fn h\u7891\'3f s\'f5 sang c\'f5 quan Ph\'e1p lu\u7853\'3ft xem x\'e9t.
\par + Doanh nghi\u7879\'3fp ng\u7915\'3fng ho\u7841\'3ft \'f0\u7897\'3fng, gi\u7843\'3fi th\u7875\'3f \'f0\'fd\u7907\'3fc tr\u7843\'3f}{\rtlch\fcs1 \af41\afs24 \ltrch\fcs0 \f41\fs28\cgrid0\insrsid9331118\charrsid791519  theo tr\'ecnh t}{\rtlch\fcs1 
\af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid9331118\charrsid791519 \u7921\'3f v\'e0 t\u7927\'3f l\u7879\'3f \u7903\'3f \'f0i\u7875\'3fm tr\'ean \'f0}{\rtlch\fcs1 \af41\afs24 \ltrch\fcs0 \f41\fs28\cgrid0\insrsid9331118\charrsid791519 \'e3 quy }{
\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid9331118\charrsid791519 \'f0\u7883\'3fnh.
\par - N\u7871\'3fu \'f0\'f5n v\u7883\'3f ngo\'e0i qu\u7889\'3fc doanh, c\'e1 nh\'e2n c\'f3 n\u7907\'3f ph\u7843\'3fi tr\u7843\'3f ph\u7843\'3f}{\rtlch\fcs1 \af41\afs24 \ltrch\fcs0 \f41\fs28\cgrid0\insrsid9331118\charrsid791519 i t\'ecm m}{\rtlch\fcs1 
\af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid9331118\charrsid791519 \u7885\'3fi ngu\u7891\'3fn v\u7889\'3fn \'f0\u7875\'3f tr\u7843\'3f n\u7907\'3f, k\u7875\'3f c\u7843\'3f g\'e1n n\u7907\'3f b\u7857\'3fng hi\u7879\'3fn v\u7853\'3ft trong th\u7901\'3f
i gian quy \'f0\u7883\'3fnh.
\par Ng\'e2n h\'e0ng c\'f3 th\u7875\'3f cho vay theo ch\u7871\'3f \'f0\u7897\'3f t\'edn d\u7909\'3fng hi\u7879\'3fn h\'e0nh \'f0\u7889\'3fi v\u7899\'3fi kinh t\u7871\'3f ngo\'e0i qu\u7889\'3fc doanh v\'e0 kinh t\u7871\'3f t\'fd nh\'e2n (ph\u7843\'3fi c\'f3 th
\u7871\'3f ch\u7845\'3fp) \'f0\u7875\'3f h\u7895\'3f tr\u7907\'3f h\u7885\'3f th\'eam ngu\u7891\'3fn v\u7889\'3fn  tr\u7843\'3f n\u7907\'3f.
\par N\u7871\'3fu \'f0\'f5n v\u7883\'3f v\'e0 c\'e1 nh\'e2n c\u7889\'3f}{\rtlch\fcs1 \af41\afs24 \ltrch\fcs0 \f41\fs28\cgrid0\insrsid9331118\charrsid791519  t\'ecnh kh\'f4ng tr}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid9331118\charrsid791519 
\u7843\'3f, th\u7921\'3fc hi\u7879\'3fn c\'fd\u7905\'3fng ch\u7871\'3f thu n\u7907\'3f, chuy\u7875\'3fn h\u7891\'3f s\'f5 sang c\'f5 quan Ph\'e1p lu\u7853\'3ft xem x\'e9t, th\u7921\'3fc hi\u7879\'3fn vi\u7879\'3fc truy c\u7913\'3fu tr\'e1ch nhi\u7879\'3f}
