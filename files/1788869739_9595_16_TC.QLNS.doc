\'f5ng III, \'d0i\u7873\'3fu 26, 27, 28, 29 c\u7911\'3fa \'d0i\u7873\'3fu l\u7879\'3f, th\u7911\'3f t\'fd\u7899\'3fng Ch\'ednh ph\u7911\'3f \'f0}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'e3 quy }{
\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f0\u7883\'3fnh quy\u7873\'3fn h\u7841\'3fn \'f0\'fd\u7907\'3fc ph\u7841\'3ft b\u7857\'3fng ti\u7873\'3fn c\u7911\'3fa nh\u7919\'3fng c\'e1n b\u7897\'3f \'f0\'fd\u7907\'3fc giao quy\u7873\'3fn ph\u7841
\'3ft vi c\u7843\'3fnh thu\u7897\'3fc ng\'e0nh C\'f4ngan, ng\'e0nh Ki\u7875\'3fm l\'e2m, Thu\u7927\'3f s\u7843\'3fn, Th\'fd\'f5ng nghi\u7879\'3fp, Y t\u7871\'3f, Giao th\'f4ng V\u7853\'3fn t\u7843\'3fi trong khi th\u7915\'3fa h\'e0nh c\'f4ng v\u7909\'3f
. M\u7895\'3fi khi ph\u7841\'3ft ti\u7873\'3fn \'f0\u7889\'3fi v\u7899\'3fi nh\u361\'3fng h\'e0nh \'f0\u7897\'3fng vi ph\u7841\'3fm lu\u7853\'3ft l\u7879\'3f, c\'e1c c\'e1n b\u7897\'3f c\'f3 th\u7849\'3fm quy\u7873\'3fn n\'f3i tr\'ean ph\u7843\'3f
i giao cho ng\'fd\u7901\'3fi b\u7883\'3f ph\u7841\'3ft m\u7897\'3ft t\u7901\'3f bi\'ean lai theo m\u7851\'3fu th\u7889\'3fng nh\u7845\'3ft \'f0\'ednh k\'e8m do S\u7903\'3f, Ty t\'e0i ch\'ednh t\u7881\'3fnh, th\'e0nh ph\u7889\'3f in v\'e0 th\u7889\'3fng nh
\u7845\'3ft qu\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'fd.
\par 2. Chi ph\'ed v\u7873\'3f vi\u7879\'3fc in bi}{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'ean lai do ng\'e2n s\'e1ch t\u7881\'3fnh, th\'e0nh ph\u7889\'3f tr\u7921\'3fc thu\u7897\'3fc trung \'fd\'f5ng \'f0\'e0i th\u7885\'3f. C\'e1c S\u7903\'3f
, Ty t\'e0i ch\'ednh qu\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'fd v\'e0 c\u7845\'3fp s\u7893\'3f bi\'ean lai c\u7847\'3fn thi\u7871\'3ft cho c\'e1c S\u7903\'3f, Ty ch\u7911\'3f qu\u7843\'3fn }{
\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f0\'fd\u7907\'3fc giao nhi\u7879\'3fm v\u7909\'3f x\u7917\'3f ph\u7841\'3ft \'f0\u7875\'3f c\'e1c S\u7903\'3f, Ty n\'e0y ph\'e2n ph\u7889\'3fi cho c\'e1c \'f0\'f5n v\u7883\'3f tr\u7921\'3fc thu\u7897
\'3fc c\u7911\'3fa m}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'ecnh trong }{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f0\u7883\'3fa ph\'fd\'f5ng. \'d0\u7889\'3fi v\u7899\'3fi c\'e1c c\'f5 quan trung \'fd\'f5ng \'f0\'f3ng \u7903\'3f 
\'f0\u7883\'3fa ph\'fd\'f5ng \'f0\'fd\u7907\'3fc giao nhi\u7879\'3fm v\u7909\'3f x\u7917\'3f ph\u7841\'3ft c\u361\'3fng nh\u7853\'3fn s\u7889\'3f bi\'ean lai c\u7847\'3fn thi\u7871\'3ft t\u7841\'3fi S\u7903\'3f, Ty t\'e0i ch\'ednh \'f0\u7883\'3fa ph\'fd
\'f5ng n\'f5i c\'f5 quan \'f0\'f3 l\'e0m nhi\u7879\'3fm v\u7909\'3f.
\par }{\f360\fs28\cgrid0\insrsid12531145\charrsid12662683 3. \'d0\u7875\'3f theo d}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f5i, qu\u7843\'3fn l\'fd ch\u7863\'3ft ch\u7869\'3f s\u7889\'3f thu v\u7873\'3f ph\u7841\'3ft vi c\u7843\'3fnh, ph\u7843\'3f
i qu\u7843\'3fn l\'fd ch\u7863\'3ft ch\u7869\'3f s\u7889\'3f bi\'ean lai ph\'e1t ra:
\par }{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 a) Bi\'ean lai \'f0\'fd\u7907\'3fc in th\'e0nh ba lo\u7841\'3fi v\'e0 ghi r}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f5 lo\u7841\'3fi bi\'ean lai ph\u7841\'3ft ti\u7873\'3fn 1}{
\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f0,00, 2\'f0,00 v\'e0 5\'f0,00. S\u7889\'3f l\'fd\u7907\'3fng bi\'ean lai lo\u7841\'3fi 1\'f0,00 c\u7847\'3fn \'f0\'fd\u7907\'3fc in nhi\u7873\'3fu h\'f5n.
\par b) Bi\'ean lai \'f0\'fd\u7907\'3fc \'f0\'f3ng th\'e0nh t\u7915\'3fng quy\u7875\'3fn, c\'f3 \'f0\'e1nh s\u7889\'3f th\u7913\'3f t\u7921\'3f c\u7911\'3fa t\u7915\'3fng quy\u7875\'3fn v\'e0 ri\'eang cho t\u7915\'3fng lo\u7841\'3fi: lo\u7841\'3fi 1\'f0,00 c
\'f3 s\u7889\'3f th\u7913\'3f t\u7921\'3f ri\'eang, lo\u7841\'3fi 2\'f0,00 v\'e0 5\'f0,00 c\'f3 s\u7889\'3f th\u7913\'3f t\u7921\'3f ri\'eang. M\u7895\'3fi quy\u7875\'3fn g\u7891\'3fm 50 t\u7901\'3f, \'f0\u7875\'3f ti\u7879\'3fn cho c\'e1n b\u7897\'3f
, chi\u7871\'3fn s\u7929\'3f \'f0em theo khi l\'e0m nhi\u7879\'3fm v\u7909\'3f. M\u7895\'3fi t\u7901\'3f c\u361\'3fng ph\u7843\'3fi c\'f3 s\u7889\'3f th\u7913\'3f t\u7921\'3f ghi v\'e0o c\u7843\'3f ph\u7847\'3fn cu\u7889\'3fng v\'e0 ph\u7847\'3f
n giao cho ng\'fd\u7901\'3fi b\u7883\'3f ph\u7841\'3ft: hai ph\u7847\'3fn c\'f9ng ghi m\u7897\'3ft s\u7889\'3f gi\u7889\'3fng nhau, \'f0\u7875\'3f ti\u7879\'3fn kh\u7899\'3fp l\u7841\'3fi khi c\'f3 khi\u7871\'3fu n\u7841\'3fi v\'e0 ki\u7875\'3fm tra khi c
\u7847\'3fn thi\u7871\'3ft. 
\par c) Khi giao cho c\'e1n b\u7897\'3f, chi\u7871\'3fn s\u7929\'3f s\u7917\'3f d\u7909\'3fng bi\'ean lai \'f0\u7875\'3f thu ti\u7873\'3fn ph\u7841\'3ft, c\'f5 quan, \'f0\'f5n v\u7883\'3f,...c\'f5 s\u7903\'3f th\u7915\'3fa h\'e0nh nhi\u7879\'3fm v\u7909\'3f ph
\u7843\'3fi \'f0\'f3ng d\u7845\'3fu gi\'e1p lai m\u7897\'3ft n\u7917\'3fa v\'e0o ph\u7847\'3fn cu\u7889\'3fng, m\u7897\'3ft n\u7917\'3fa v\'e0o ph\u7847\'3fn giao cho ng\'fd\u7901\'3fi b\u7883\'3f ph\u7841\'3ft, ph\u7843\'3fi \'f0\'f3ng d\u7845\'3fu r}{
\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f5 r\'e0ng }{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f0\u7875\'3f ti\u7879\'3fn ki\u7875\'3fm tra v\'e0 ph}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f2ng ng\u7915\'3fa gi\u7843\'3f
 m\u7841\'3fo bi\'ean lai. Khi thu ti\u7873\'3fn ph\u7841\'3ft v\'e0 c\u7845\'3fp bi\'ean lai, c\'e1n b\u7897\'3f c\'f3 th\u7849\'3fm quy\u7873\'3fnx\u7917\'3f ph\u7841\'3ft ph\u7843\'3fi ghi }{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f0\u7847
\'3fy \'f0\u7911\'3f n\u7897\'3fi dung v\'e0o nh\u7919\'3fng ch\u7895\'3f c}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f2n }{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f0\u7875\'3f tr\u7889\'3fng, cu\u7889\'3fi c\'f9ng ghi r}{
\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f5 h\u7885\'3f t\'ean th\u7853\'3ft v\'e0 ch\u7919\'3f k\'fd c\u7911\'3fa m\'ecnh v\'e0o }{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 bi\'ean lai \u7903\'3f c\u7843\'3f ph\u7847\'3fn cu\u7889\'3f
ng v\'e0 ph\u7847\'3fn giao cho ng\'fd\u7901\'3fi b\u7883\'3f ph\u7841\'3ft.
\par d) C\'e1c S\u7903\'3f, Ty t\'e0i ch\'ednh giao bi\'ean lai cho c\'e1c S\u7903\'3f, Ty c\'f4ng an, Ki\u7875\'3fm l\'e2m, Thu\u7927\'3f s\u7843\'3fn, Th\'fd\'f5ng nghi\u7879\'3fp, Y t\u7871\'3f, Giao th\'f4ng V\u7853\'3fn t\u7843\'3fi ho\u7863\'3fc cho c
\'e1c c\'f5 quan trung \'fd\'f5ng \'f0\'f3ng \u7903\'3f \'f0\u7883\'3fa ph\'fd\'f5ng \'f0\'fd\u7907\'3fc giao nhi\u7879\'3fm v\u7909\'3f s\u7917\'3f ph\u7841\'3ft vi c\u7843\'3fnh, c\u361\'3fng nh\'fd khi c\'e1c S\u7903\'3f, Ty, c\'e1c c\'f5 quan n\'e0
y nh\u7853\'3fn s\u7889\'3f bi\'ean lai c\u7911\'3fa S\u7903\'3f, Ty t\'e0i ch\'ednh v\'e0 giao l\u7841\'3fi cho c\'e1c \'f0\'f5n v\u7883\'3f tr\u7921\'3fc thu\u7897\'3fc, \'f0\u7873\'3fu ph\u7843\'3fi m\u7903\'3f s\u7893\'3f ghi ch\'e9p r}{
\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f5 r\'e0ng }{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f0\u7875\'3f th\'fd\u7901\'3fng xuy\'ean n\u7855\'3fm \'f0\'fd\u7907\'3fc s\u7889\'3f bi\'ean lai nh\u7853\'3fp, xu\u7845\'3ft, t\u7891
\'3fn kho, ti\u7879\'3fn cho vi\u7879\'3fc theo d}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f5i, ki\u7875\'3fm tra, thanh to\'e1n sau n\'e0y. N\u7897\'3fi dung s\u7893\'3f theo d\'f5i ph\u7843\'3fi }{
\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f0\u7843\'3fm b\u7843\'3fo c\'e1c y\'eau c\u7847\'3fu nh\'fd sau:
\par }{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 + Khi nh\u7853\'3fn bi\'ean lai v\u7873\'3f: Ph\u7843\'3fi ghi r\'f5 s\u7889\'3f l}{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'fd\u7907\'3fng bi\'ean lai (bao nhi\'eau quy\u7875\'3fn), c\'f3 ph
\'e2n t\'edch t\u7915\'3fng lo\u7841\'3fi 1\'f0,00, 2\'f0,00.v.v, tr\u7883\'3f gi\'e1 th\'e0nh ti\u7873\'3fn t\u7915\'3fng lo\u7841\'3fi v\'e0 t\u7893\'3fng c\u7897\'3fng tr\u7883\'3f gi\'e1 to\'e0n b\u7897\'3f s\u7889\'3f bi\'ean lai \'f0}{
\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'e3 nh\u7853\'3fn.
\par }{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 + Khi giao bi\'ean lai cho c\'e1c \'f0\'f5n v\u7883\'3f ph\u7843\'3fi ghi r}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f5:
\par }{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 - H\u7885\'3f, t\'ean, ch\u7913\'3fc v\u7909\'3f ng\'fd\u7901\'3fi nh\u7853\'3fn
\par - S\u7889\'3f v\'e0 ng\'e0y c\u7911\'3fa gi\u7845\'3fy gi\u7899\'3fi thi\u7879\'3fu \'f0\u7871\'3fn nh\u7853\'3fn bi\'ean lai
\par - C\'f5 quan, \'f0\'f5n v\u7883\'3f gi\u7899\'3fi thi\u7879\'3fu
\par - T\u7893\'3fng s\u7889\'3f quy\u7875\'3fn bi\'ean lai \'f0}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'e3 nh\u7853\'3fn
\par - Ph\'e2n t\'edch ri\'eang t\u7915\'3fng lo\u7841\'3fi:
\par }{\f360\fs28\cgrid0\insrsid12531145\charrsid12662683 - Lo\u7841\'3fi 1\'f0,00:      - S\u7889\'3f quy\u7875\'3fn}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 
\par }{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 -  S\u7889\'3f hi\u7879\'3fu quy\u7875\'3fn bi\'ean lai (T\u7915\'3f s\u7889\'3f...\'f0\u7871\'3fn s\u7889\'3f...)
\par }{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 - Tr\u7883\'3f gi\'e1 th\'e0nh ti\u7873\'3fn
\par }{\f360\fs28\cgrid0\insrsid12531145\charrsid12662683 - Lo\u7841\'3fi 2\'f0,00:      - S\u7889\'3f quy\u7875\'3fn
\par }{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 -  S\u7889\'3f hi\u7879\'3fu quy\u7875\'3fn bi\'ean lai (T\u7915\'3f s\u7889\'3f...\'f0\u7871\'3fn s\u7889\'3f...)
\par }{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 - Tr\u7883\'3f gi\'e1 th\'e0nh ti\u7873\'3fn
\par }{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 - Lo\u7841\'3fi 5\'f0,00:- Nh\'fd tr\'ean-
\par - T\u7893\'3fng c\u7897\'3fng tr\u7883\'3f gi\'e1 to\'e0n b\u7897\'3f bi\'ean lai \'f0}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'e3 nh\u7853\'3fn
\par - Ch\u7919\'3f k\'fd c\u7911\'3fa ng}{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'fd\u7901\'3fi nh}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \u7853\'3fn bi\'ean lai
\par + Cu\u7889\'3fi th\'e1ng ph\u7843\'3fi c\u7897\'3fng s\u7893\'3f theo d\'f5i s\u7889\'3f bi\'ean lai }{\f360\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f0}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'e3 nh\u7853\'3fn v\'e0 }{
\f360\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f0}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'e3 giao r\'fat ra s\u7889\'3f d}{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'fd ph\u7843\'3fn \u7843\'3fnh s\u7889\'3f  bi\'ean lai t
\u7891\'3fn kho. H\'e0ng qu}{\f360\fs28\cgrid0\insrsid12531145\charrsid12662683 \'fd ph\u7843\'3fi \'f0\u7889\'3fi chi\u7871\'3fu s\u7889\'3f d}{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'fd tr\'ean s\u7893\'3f s\'e1ch v\u7899\'3fi t\u7891\'3f
n kho th\u7921\'3fc t\u7871\'3f. N\u7871\'3fu c\'f3 ch\'eanh l\u7879\'3fch, ph\u7843\'3fi ki\u7875\'3fm tra, x\'e1c minh l\u7853\'3fp bi\'ean b\u7843\'3fn, b\'e1o c\'e1o nguy\'ea}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 n nh\'e2n, quy tr\'e1
ch nhi\u7879\'3fm c\u7909\'3f th\u7875\'3f b\'e1o c\'e1o c\u7845\'3fp tr\'ean c\'f3 th\u7849\'3fm quy\u7873\'3fn x\'e9t, x\u7917\'3f l\'fd theo nguy\'ean t\u7855\'3fc s\u7869\'3f n\'f3i \u7903\'3f ph\u7847\'3fn sau.
\par }\pard\plain \s2\qc \li0\ri0\keepn\widctlpar\tx0\tx270\faauto\outlinelevel1\adjustright\rin0\lin0\itap0\pararsid11480604 \b\f59\fs20\cf2\lang3081\langfe1033\cgrid\langnp3081\langfenp1033 {\f0\fs28\cf0\insrsid12531145\charrsid12662683 II. THANH TO\'c1N TI
\u7872\'3fN N\u7896\'3fP PH\u7840\'3fT V\'c0O NG\'c2N S\'c1CH V\'c0 THANH TO\'c1N BI\'caN LAI GIAO NH\u7852\'3fN}{\f0\fs28\cf0\insrsid12531145\charrsid12662683 
\par }\pard\plain \qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\widctlpar\faauto\adjustright\rin0\lin0\itap0\pararsid9964368 \f36\fs26\lang3081\langfe1033\cgrid\langnp3081\langfenp1033 {\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 1. Thanh to\'e1n ti\u7873
\'3fn n\u7897\'3fp ph\u7841\'3ft v\'e0o ng\'e2n s\'e1ch: 
\par Kho\u7843\'3fn thu v\u7873\'3f ti\u7873\'3fn ph\u7841\'3ft vi c\u7843\'3f}{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 nh  l\'e0 kho\u7843\'3fn t\u7841\'3fp thu c\u7911\'3fa ng\'e2n s\'e1c Nh\'e0 n\'fd\u7899\'3fc. T\u7845\'3ft c\u7843\'3f c\'e1
c kho\u7843\'3fn ph\u7841\'3ft vi c\u7843\'3fnh b\u7857\'3fng ti\u7873\'3fn \'f0\u7873\'3fu n\u7897\'3fp v\'e0o ng\'e2n s\'e1ch t\u7881\'3fnh, th\'e0nh ph\u7889\'3f (k\u7875\'3f c\u7843\'3f nh\u7919\'3fng kho\u7843\'3fn ti\u7873\'3fn do c\'e1c \'f0\'f5n v
\u7883\'3f trung \'fd\'f5ng thu) v\'e0 ghi v\'e0o lo\u7841\'3fi 5, kho\u7843\'3fn 116, h\u7841\'3fng 4, m\u7909\'3fc l\u7909\'3fc ng\'e2n s\'e1ch hi\u7879\'3fn h\'e0nh.
\par }{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 Ri\'eang ph\u7847\'3fn thu \u7903\'3f x\'e3 }{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f0\'fd\u7907\'3fc n\u7897\'3fp v\'e0o ng\'e2n s\'e1ch x}{
\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'e3.
\par }{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 Vi\u7879\'3fc thu n\u7897\'3fp ti\u7873\'3fn ph\u7841\'3ft v\'e0o ng\'e2n s\'e1ch \'f0\u7883\'3fa ph\'fd\'f5ng ph\u7843\'3fi th\u7921\'3fc hi\u7879\'3fn h\'e0ng tu\u7847\'3fn ho\u7863\'3fc h\'e0ng th
\'e1ng do c\'e1c S\u7903\'3f, Ty t\'e0i ch\'ednh th\u7889\'3fng nh\u7845\'3ft v\u7899\'3fi c\'e1c S\u7903\'3f, Ty ch\u7911\'3f qu\u7843\'3fn quy \'f0\u7883\'3fnh v\'e0 ph\u7843\'3fi thu n\u7897\'3fp h\u7871\'3ft v\'e0o Ng\'e2n s\'e1ch, kh\'f4ng \'f0\'fd
\u7907\'3fc d\'f9ng ti\u7873\'3fn thu v\u7873\'3f ph}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \u7841\'3ft vi c\u7843\'3fnh v\'e0o b\u7845\'3ft c\u7913\'3f vi\u7879\'3fc g\'ec c\u7911\'3fa }{\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f0
\'f5n v\u7883\'3f ho\u7863\'3fc c\'e1 nh\'e2n. Khi thu n\u7897\'3fp ti\u7873\'3fn v\'e0o ng\'e2n s\'e1ch \u7903\'3f Ng\'e2n h\'e0ng Nh\'e0 n\'fd\u7899\'3fc \'f0\u7873\'3fu ph\u7843\'3fi c\'f3 gi\u7845\'3fy t\u7901\'3f giao nh\u7853\'3fn gi\u7919\'3fa Ng
\'e2n h\'e0ng Nh\'e0 n\'fd\u7899\'3fc v\'e0 \'f0\'f5n v\u7883\'3f n\u7897\'3fp ti\u7873\'3fn. 
\par 2. Vi\u7879\'3fc thanh to\'e1n s\u7889\'3f bi\'ean lai \'f0}{\f0\fs28\cgrid0\insrsid12531145\charrsid12662683 \'e3 giao, nh\u7853\'3fn gi\u7919\'3fa c\'e1n b\u7897\'3f tr\u7921\'3fc ti\u7871\'3fp thu ti\u7873\'3f}{
\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 n ph\u7841\'3ft v\u7899\'3fi c\'f5 quan qu\u7843\'3fn l}{\f360\fs28\cgrid0\insrsid12531145\charrsid12662683 \'fd c\'e1n b\u7897\'3f \'f0\'f3, gi\u7919\'3fa c}{
\f368\fs28\cgrid0\insrsid12531145\charrsid12662683 \'f5 quan c\u7845\'3fp d\'fd\u7899\'3fi v\u7899\'3fi c\'f5 quan c\u7845\'3fp tr\'ean, gi\u7919\'3fa S\u7903\'3f, Ty ch\u7911\'3f qu\u7843\'3fn v\u7899\'3fi S\u7903\'3f, Ty t\'e0i ch\'ednh v\'e0 gi\u7919
\'3fa \'f0\'f5n v\u7883\'3f tr\u7921\'3fc thu\u7897\'3fc trung \'fd\'f5ng v\u7899\'3fi S\u7903\'3f, Ty t\'e0i ch\'ednh n\'f5i \'f0\'f5n v\u7883\'3f \'f0\'f3 \'f0\'f3ng tr\u7909\'3f s\u7903\'3f, \'f0\'fd\u7907\'3fc quy \'f0\u7883\'3fnh nh\'fd sau:
\par }\trowd \irow0\irowband0\ts11\trgaph108\trleft0\trftsWidth3\trwWidth9214\trftsWidthB3\trftsWidthA3\trpaddl108\trpaddr108\trpaddfl3\trpaddfr3 \clvertalt\clbrdrt\brdrnone \clbrdrl\brdrnone \clbrdrb\brdrnone \clbrdrr\brdrnone 
