\par \tab C\'a8n c\'f8 Ngh\'de \'ae\'denh s\'e8 178/CP ng\'b5y 28/10/1994 c\'f1a Ch\'ddnh ph\'f1 v\'d2 nhi\'d6m v\'f4, quy\'d2n h\'b9n v\'b5 t\'e6 ch\'f8c b\'e9 m\'b8y B\'e9 T\'b5i ch\'ddnh;
\par  \tab C\'a8n c\'f8 k\'d5t qu\'b6 h\'e4c t\'cbp c\'f1a kho\'b8 \'ae\'b5o t\'b9o Gi\'b8o vi\'aan B\'b6o hi\'d3m thu\'e9c d\'f9 \'b8n ASSUR v\'b5 nhu c\'c7u b\'e5i d\'ad\'ecng nghi\'d6p v\'f4 B\'b6o hi\'d3m;
\par \tab Theo \'ae\'d2 ngh\'de c\'f1a c\'b8c \'ae\'e5ng ch\'dd :Th\'f1 tr\'ad\'ebng c\'b8c \'ae\'acn v\'de c\'e3 h\'e4c vi\'aan \'aei h\'e4c, Gi\'b8m \'ae\'e8c d\'f9 \'b8n ASSUR v\'b5 V\'f4 tr\'ad\'ebng V\'f4 T\'e6 ch\'f8c c\'b8n b\'e9 v\'b5 \'a7\'b5o t\'b9o;

