\par }{\rtlch\fcs1 \ab\af0\afs20 \ltrch\fcs0 \b\f0\fs28\expnd4\expndtw24\lang1033\langfe1033\langnp1033\insrsid8537464\charrsid3224771 I- \'d0\u7888\'3fI T\'dd\u7906\'3fNG V\'c0 PH\u7840\'3fM VI M\u7902\'3f T\'c0I KHO\u7842\'3fN}{\rtlch\fcs1 \af0\afs24 
