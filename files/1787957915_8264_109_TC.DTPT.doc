\par }\pard \ltrpar\qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\widctlpar\tx961\tx1681\tx2401\tx3121\tx3841\tx4561\tx5281\tx6001\tx6721\tx7441\tx8161\tx8881\tx9601\tx10321\wrapdefault\faauto\adjustright\rin0\lin0\itap0\pararsid2176834 {\rtlch\fcs1 \af0\afs24 
\ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 1. Trong n\u7897\'3fi b\u7897\'3f h\u7879\'3f th\u7889\'3fng T\u7893\'3fng c\u7909\'3fc \'d0\u7847\'3fu t\'fd ph\'e1t tri\u7875\'3fn
\par 1.1. \'d0\u7889\'3fi v\u7899\'3fi ngu\u7891\'3fn v\u7889\'3fn \'f0\u7847\'3fu t\'fd thu\u7897\'3fc NSTW
\par - TC\'d0TPT ti\u7871\'3fn h\'e0nh ph\'e2n ph\u7889\'3fi v\u7889\'3fn cho c\'e1c \'f0\'f5n v\u7883\'3f tr\u7921\'3fc thu\u7897\'3fc b\u7857\'3fng h\u7841\'3fn m\u7913\'3fc c\u7845\'3fp v\u7889\'3fn (sau khi c\'f3 x\'e1c nh\u7853\'3fn c\u7911\'3fa KBNN). 
\'d0\'e2y l\'e0 m\u7913\'3fc v\u7889\'3fn t\u7889\'3fi \'f0a cho ph\'e9p c\u7845\'3fp ph\'e1t ho\u7863\'3fc cho vay c\u7911\'3fa m\u7895\'3fi \'f0\'f5n v\u7883\'3f \'f0\u7847\'3fu t\'fd ph\'e1t tri\u7875\'3fn.
\par - H\u7841\'3fn m\u7913\'3fc c\u7845\'3fp v\u7889\'3fn, (v\u7889\'3fn c\u7845\'3fp ph\'e1t ho\u7863\'3fc cho vay) do T\u7893\'3fng c\u7909\'3fc \'f0\u7847\'3fu t\'fd ph\'e1t tri\u7875\'3fn,  l\u7853\'3fp l\'e0m 5 li\'ean: 1 li\'ean l\'fdu, 2 li\'ean g
\u7917\'3fi KBNN \'f0\u7891\'3fng c\u7845\'3fp, 1 li\'ean g\u7917\'3fi C\u7909\'3fc \'f0\u7847\'3fu t\'fd ph\'e1t tri\u7875\'3fn.
\par - Khi nh\u7853\'3fn \'f0\'fd\u7907\'3fc th\'f4ng b\'e1o h\u7841\'3fn m\u7913\'3fc c\u7845\'3fp v\u7889\'3fn c\u7911\'3fa T\u7893\'3fng c\u7909\'3fc \'f0\u7847\'3fu t\'fd ph\'e1t tri\u7875\'3fn, C\u7909\'3fc \'f0\u7847\'3fu t\'fd ph\'e1t tri\u7875\'3fn ti
\u7871\'3fn h\'e0nh ghi nh\u7853\'3fp h\u7841\'3fn m\u7913\'3fc v\'e0o t\'e0i kho\u7843\'3f}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 \f40\fs28\cgrid0\insrsid8537464\charrsid3224771 n theo d\'f5i ngo\'e0i b}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 
\f0\fs28\cgrid0\insrsid8537464\charrsid3224771 \u7843\'3fng c\'e2n \'f0\u7889\'3fi k\u7871\'3f to\'e1n. Khi th\u7921\'3fc hi\u7879\'3fn c\u7845\'3fp ph\'e1t (ho\u7863\'3fc cho vay) ghi xu\u7845\'3ft t\'e0i kho\u7843\'3fn h\u7841\'3fn m\u7913\'3fc.
\par - \'d0\u7883\'3fnh k\u7923\'3f}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 \f40\fs28\cgrid0\insrsid8537464\charrsid3224771  h\'e0ng qu\'fd, n}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 \'e3m C\u7909\'3fc, chi c\u7909\'3fc 
\'f0\u7847\'3fu t\'fd ph\'e1t tri\u7875\'3fn ch\u7883\'3fu tr\'e1ch nhi\u7879\'3fm quy\u7871\'3ft to\'e1n s\u7889\'3f v\u7889\'3fn \'f0}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 \f40\fs28\cgrid0\insrsid8537464\charrsid3224771 \'e3 c}{\rtlch\fcs1 \af0\afs24 
\ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 \u7845\'3fp ph\'e1t (ho\u7863\'3fc cho vay) v\u7899\'3fi T\u7893\'3fng c\u7909\'3fc \'f0\u7847\'3fu t\'fd ph\'e1t tri\u7875\'3fn.
\par 1.2. \'d0\u7889\'3fi v\u7899\'3fi ngu\u7891\'3fn v\u7889\'3fn \'f0\u7847\'3fu t\'fd thu\u7897\'3fc NS\'d0P:
\par \u7902\'3f C\u7909\'3fc \'d0TPT, sau khi nh\u7853\'3fn v\u7889\'3fn c\u7845\'3fp ph\'e1t, cho vay t\u7915\'3f NS\'d0P chuy\u7875\'3fn qua, ti\u7871\'3fn h\'e0nh ph\'e2n  ph\u7889\'3fi cho chi c\u7909\'3fc \'d0TPT tr\u7921\'3fc thu\u7897\'3fc th\'f4
ng qua t\'e0i kho\u7843\'3fn ti\u7873\'3fn g\u7917\'3fi t\u7841\'3fi KBNN. Vi\u7879\'3fc c\u7845\'3fp ph\'e1t v\'e0 thanh to\'e1n \'f0\'fd\u7907\'3fc th\u7921\'3fc hi\u7879\'3fn trong ph\u7841\'3fm vi ti\u7873\'3fn g\u7917\'3fi c\u7911\'3fa C\u7909\'3f
c, chi c\u7909\'3fc \'d0TPT \u7903\'3f KBNN.
\par 2. Gi\u7919\'3fa c\'e1c \'f0\'f5n v\u7883\'3f thu\u7897\'3fc TC\'d0TPT v\u7899\'3fi NSNN v\'e0 KBNN
\par - NSNN (Trung \'fd\'f5ng v\'e0 \'f0\u7883\'3fa ph\'fd\'f5ng) chuy\u7875\'3fn v\u7889\'3fn c\u7845\'3fp ph\'e1t v\u7889\'3fn t\'edn d\u7909\'3fng \'f0\u7847\'3fu t\'fd \'fdu \'f0}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 
\f40\fs28\cgrid0\insrsid8537464\charrsid3224771 \'e3i cho }{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 \'f0\'f5n v\u7883\'3f thu\u7897\'3fc TC\'d0TPT b\u7857\'3fng l\u7879\'3fnh chi ti\u7873\'3fn qua KBNN.
\par - Khi nh\u7853\'3fn \'f0\'fd\u7907\'3fc l\u7879\'3fnh chi ti\u7873\'3fn c\u7911\'3fa c\'f5 quan T\'e0i ch\'ednh, KBNN c\'f3 tr\'e1ch nhi\u7879\'3fm ghi t\'e3ng cho t\'e0i kho\u7843\'3fn ti\u7873\'3fn g\u7917\'3fi v\'e0 b\'e1o c\'f3 cho \'f0\'f5n v\u7883
\'3f thu\u7897\'3fc TC\'d0TPT.
\par - H\'e0ng ng\'e0y, KBNNTW c\'f3 tr\'e1ch nhi\u7879\'3fm b\'e1o n\u7907\'3f cho TC\'d0TPT v\u7873\'3f c\'e1c kho\u7843\'3fn \'f0}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 \f40\fs28\cgrid0\insrsid8537464\charrsid3224771 \'e3 c}{\rtlch\fcs1 \af0\afs24 
\ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 \u7845\'3fp ph\'e1t (ho\u7863\'3f}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 \f40\fs28\cgrid0\insrsid8537464\charrsid3224771 c cho vay) qua TK thanh to\'e1n v\'e3ng lai c}{\rtlch\fcs1 \af0\afs24 
\ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 \'e3n c\u7913\'3f b\u7843\'3fng k\'ea ho\u7863\'3fc c\'e1c ch\u7913\'3fng t\u7915\'3f thanh to\'e1n LKB do c\'e1c KBNN c\u7845\'3fp d\'fd\u7899\'3fi chuy\u7875\'3fn v\u7873\'3f. \'d0\u7889\'3fi v
\u7899\'3fi v\u7889\'3fn Ng\'e2n s\'e1ch \'f0\u7883\'3fa ph\'fd\'f5ng th}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 \f40\fs28\cgrid0\insrsid8537464\charrsid3224771 \'ec KBNN th}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 
\u7921\'3fc hi\u7879\'3fn b\'e1o n\u7907\'3f theo t\u7915\'3fng l\u7847\'3fn thanh to\'e1n v\'e0 ghi gi\u7843\'3fm TK ti\u7873\'3fn g\u7917\'3fi c\u7911\'3fa C\u7909\'3fc \'d0TPT.
\par - \'d0\u7883\'3fnh k\u7923\'3f}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 \f40\fs28\cgrid0\insrsid8537464\charrsid3224771  h\'e0ng th\'e1ng, qu\'fd, n}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 \'e3m, KBNN v\'e0 \'f0\'f5
n v\u7883\'3f thu\u7897\'3fc TC\'d0TPT c\'f3 tr\'e1ch nhi\u7879\'3fm ki\u7875\'3fm tra, \'f0\u7889\'3fi chi\u7871\'3fu s\u7889\'3f li\u7879\'3fu tr\'ean t\'e0i kho\u7843\'3fn ti\u7873\'3fn g\u7917\'3fi v\'e0 c\'e1c t\'e0i kho\u7843\'3fn thanh to\'e1n kh
\'e1c. Tr\'fd\u7901\'3fng h\u7907\'3fp c\'f3 ch\'eanh l\u7879\'3fch ph\u7843\'3fi ki\u7875\'3fm tra v\'e0 \'f0i\u7873\'3fu ch\u7881\'3fnh k\u7883\'3fp th\u7901\'3fi.
\par - \'d0\u7883\'3fnh k\u7923\'3f}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 \f40\fs28\cgrid0\insrsid8537464\charrsid3224771  h\'e0ng th\'e1ng, qu\'fd, n}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 \'e3m, \'f0\'f5n v\u7883
\'3f thu\u7897\'3fc TC\'d0TPT c\'f3 tr\'e1ch nhi\u7879\'3fm b\'e1o c\'e1o v\'e0 quy\u7871\'3ft to\'e1n s\u7889\'3f v\u7889\'3fn \'f0}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 \f40\fs28\cgrid0\insrsid8537464\charrsid3224771 \'e3 c}{\rtlch\fcs1 \af0\afs24 
\ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 \u7845\'3fp ph\'e1t v\u7899\'3fi NSNN.
\par 3. Gi\u7919\'3fa c\'e1c \'f0\'f5n v\u7883\'3f thu\u7897\'3fc TC\'d0TPT v\u7899\'3fi c\u7845\'3fp tr\'ean ch\u7911\'3f \'f0\u7847\'3fu t\'fd v\'e0  ch\u7911\'3f \'f0\u7847\'3fu t\'fd:
\par - Sau khi nh\u7853\'3fn \'f0\'fd\u7907\'3fc th\'f4ng b\'e1o h\u7841\'3fn m\u7913\'3fc c\u7845\'3fp ph\'e1t v\u7889\'3fn,  h\u7841\'3fn m\u7913\'3fc cho vay, c\'f5 quan c\u7845\'3fp tr\'ean ch\u7911\'3f \'f0\u7847\'3fu t\'fd ti\u7871\'3fn h\'e0nh l\u7853
\'3fp gi\u7845\'3fy b\'e1o ph\'e2n ph\u7889\'3fi h\u7841\'3fn m\u7913\'3fc c\u7845\'3fp ph\'e1t cho c\'e1c ch\u7911\'3f \'f0\u7847\'3fu t\'fd \'f0\u7891\'3fng th\u7901\'3fi g\u7917\'3fi \'f0\u7871\'3fn \'f0\'f5n v\u7883\'3f thu\u7897\'3fc TC\'d0TPT \'f0
\u7891\'3fng c\u7845\'3fp. \'d0\'f5n v\u7883\'3f thu\u7897\'3fc TC\'d0TPT t\u7893\'3fng h\u7907\'3fp, ph\'e2n lo\u7841\'3fi \'f0\u7883\'3fa b\'e0n v\'e0 ti\u7871\'3fn h\'e0nh g\u7917\'3fi \'f0\'f5n v\u7883\'3f thu\u7897\'3fc TC\'d0TPT c\u7845\'3fp d\'fd
\u7899\'3fi \'f0\u7875\'3f}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 \f40\fs28\cgrid0\insrsid8537464\charrsid3224771  theo d\'f5i, qu}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 \u7843\'3f}{\rtlch\fcs1 \af40\afs24 
\ltrch\fcs0 \f40\fs28\cgrid0\insrsid8537464\charrsid3224771 n l\'fd v\'e0 c}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 \u7845\'3fp ph\'e1t v\u7889\'3fn, cho vay v\u7889\'3fn.
\par - Vi\u7879\'3fc qu\u7843\'3f}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 \f40\fs28\cgrid0\insrsid8537464\charrsid3224771 n l\'fd, th}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 \u7849\'3fm tra, th\u7849\'3fm \'f0\u7883\'3f
nh, c\u7845\'3fp ph\'e1t v\u7889\'3fn, cho vay v\u7889\'3fn th\u7921\'3fc hi\u7879\'3fn theo ch\u7871\'3f \'f0\u7897\'3f qu\u7843\'3f}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 \f40\fs28\cgrid0\insrsid8537464\charrsid3224771 n l\'fd c}{\rtlch\fcs1 \af0\afs24 
\ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 \u7845\'3fp ph\'e1t v\u7889\'3fn \'d0TXDCB hi\u7879\'3fn h\'e0nh.
\par }\pard \ltrpar\qc \li0\ri0\widctlpar\tx961\tx1681\tx2401\tx3121\tx3841\tx4561\tx5281\tx6001\tx6721\tx7441\tx8161\tx8881\tx9601\tx10321\wrapdefault\faauto\adjustright\rin0\lin0\itap0\pararsid4351460 {\rtlch\fcs1 \ab\af0\afs20 \ltrch\fcs0 
