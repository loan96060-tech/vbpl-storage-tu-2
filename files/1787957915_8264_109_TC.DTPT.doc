\par }\pard \ltrpar\qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\widctlpar\tx961\tx1681\tx2401\tx3121\tx3841\tx4561\tx5281\tx6001\tx6721\tx7441\tx8161\tx8881\tx9601\tx10321\wrapdefault\faauto\adjustright\rin0\lin0\itap0\pararsid12584743 {\rtlch\fcs1 
\af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 1. C\'e1c \'f0\'f5n v\u7883\'3f thu\u7897\'3fc TC\'d0TPT:
\par 1.1. TC\'d0TPT \'f0\'fd\u7907\'3fc m\u7903\'3f t\'e0i kho\u7843\'3fn ti\u7873\'3fn g\u7917\'3fi b\u7857\'3fng \'f0\u7891\'3fng Vi\u7879\'3ft nam v\'e0 ngo\u7841\'3fi t\u7879\'3f t\u7841\'3fi  Kho b\u7841\'3fc Nh\'e0 n\'fd\u7899\'3fc Trung \'fd\'f5ng. C
\u7909\'3fc \'d0\u7847\'3fu t\'fd ph\'e1t tri\u7875\'3fn \'f0\'fd\u7907\'3fc m\u7903\'3f t\'e0i kho\u7843\'3f}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 \f40\fs28\cgrid0\insrsid8537464\charrsid3224771 n thanh to\'e1n v\'e3ng lai t}{\rtlch\fcs1 \af0\afs24 
\ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 \u7841\'3fi KBNN tr\'ean \'f0\u7883\'3fa b\'e0n \'f0\u7875\'3f thanh to\'e1n c\'e1c kho\u7843\'3fn c\u7845\'3fp ph\'e1t, cho vay b\u7857\'3fng ngu\u7891\'3fn v\u7889\'3fn t\u7915\'3f Ng\'e2n s\'e1
ch Trung \'fd\'f5ng.
\par 1.2. C\u7909\'3fc \'d0\u7847\'3fu t\'fd ph\'e1t tri\u7875\'3fn, Chi c\u7909\'3fc \'d0\u7847\'3fu t\'fd ph\'e1t tri\u7875\'3fn \'f0\'fd\u7907\'3fc m\u7903\'3f t\'e0i kho\u7843\'3fn ti\u7873\'3fn g\u7917\'3fi b\u7857\'3fng \'f0\u7891\'3fng Vi\u7879\'3f
t nam v\'e0 ngo\u7841\'3fi t\u7879\'3f \u7903\'3f KBNN \'f0\u7883\'3fa ph\'fd\'f5ng \'f0\u7875\'3f c\u7845\'3fp ph\'e1t v\'e0 cho vay \'f0\u7847\'3fu  t\'fd \'fdu \'f0}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 \f40\fs28\cgrid0\insrsid8537464\charrsid3224771 
\'e3i }{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 b\u7857\'3fng ngu\u7891\'3fn v\u7889\'3fn c\u7911\'3fa Ng\'e2n s\'e1ch \'d0\u7883\'3fa ph\'fd\'f5ng.
\par 1.3. M\u7895\'3fi \'f0\'f5n v\u7883\'3f thu\u7897\'3fc TC\'d0TPT ch\u7881\'3f \'f0\'fd\u7907\'3fc m\u7903\'3f t\'e0i kho\u7843\'3fn t\u7841\'3fi m\u7897\'3ft Kho b\u7841\'3fc Nh\'e0 n\'fd\u7899\'3fc tr\'ean c\'f9ng \'f0\u7883\'3fa b\'e0n. Tr\'fd\u7901\'3f
ng h\u7907\'3fp mu\u7889\'3fn m\u7903\'3f t\'e0i kho\u7843\'3fn t\u7841\'3fi Kho b\u7841\'3fc Nh\'e0 n\'fd\u7899\'3fc kh\'e1c \'f0\u7883\'3fa b\'e0n ph\u7843\'3fi c\'f3 s\u7921\'3f \'f0\u7891\'3f}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 
\f40\fs28\cgrid0\insrsid8537464\charrsid3224771 ng \'fd c}{\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid8537464\charrsid3224771 \u7911\'3fa Kho b\u7841\'3fc Nh\'e0 n\'fd\u7899\'3fc c\u7845\'3fp tr\'ean b\u7857\'3fng v\'e3n b\u7843\'3fn.

\par 1.4. S\u7889\'3f d\'fd tr\'ean t\'e0i kho\u7843\'3fn ti\u7873\'3fn g\u7917\'3fi c\u7911\'3fa c\'e1c \'f0\'f5n v\u7883\'3f thu\u7897\'3fc TC\'d0TPT m\u7903\'3f t\u7841\'3fi Kho b\u7841\'3fc Nh\'e0 n\'fd\u7899\'3fc kh\'f4ng \'f0\'fd\u7907\'3fc h\'fd\u7903
\'3f}{\rtlch\fcs1 \af40\afs24 \ltrch\fcs0 \f40\fs28\cgrid0\insrsid8537464\charrsid3224771 ng l\'e3i.
