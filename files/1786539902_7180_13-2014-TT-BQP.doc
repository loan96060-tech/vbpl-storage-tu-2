    <script type="text/javascript">
        $(document).ready(function () {



            registerplay();

        });

        var play = 0;
        function registerplay() {

            if (play == 0) {
                $('#register2').hide();
                $('#register1').show();

                play = 1;
            }
            else {
                $('#register1').hide();
                $('#register2').show();
                play = 0;
            }
            setTimeout('registerplay()', 1500);

        }
    </script>

