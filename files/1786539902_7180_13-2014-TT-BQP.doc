        <div id="feedback-dialog-form" title="Gửi góp ý" style="display: none;">
        <form action="/" method="post" id="FrFeedBack">
        <table border="0" width="100%">
            <tr>
                <td colspan="2" align="center">
                    <span style="font-size: 15px; color: Red; font-weight: bold; padding: 10px">Góp Ý Cho
                        THƯ VIỆN PHÁP LUẬT</span>
                </td>
            </tr>
            <tr>
                <td width="80px">
                    <p class="name">
                        Họ & Tên:</p>
                </td>
                <td width="550px">
                    <input name="fbName" type="text" maxlength="100" id="fbName" class="txt-info" value="">
                </td>
            </tr>
            <tr>
                <td width="80px">
                    <p class="name">
                        Email:</p>
                </td>
                <td>
                    <input name="fbEmail" type="text" maxlength="100" id="fbEmail" class="txt-info" value="">
                </td>
            </tr>
            <tr>
                <td width="80px">
                    <p class="name">
                        Điện thoại:</p>
                </td>
                <td>
                    <input name="fbPhone" type="text" maxlength="20" id="fbPhone" class="txt-info" value="">
                </td>
            </tr>
            <tr>
                <td width="80px">
                    <p class="name">
                        Nội dung:</p>
                </td>
                <td>
                    <textarea name="fbContent" id="fbContent" class="txt-info-area" style="height: 300px"
                        maxlength="2000"></textarea>
                </td>
            </tr>
        </table>
        </form>
    </div>
    <div id="changepass-dialog-form" title="Thay đổi mật khẩu cá nhân" style="display: none;">
        <form action="/" method="post" id="FrChangePassword">
        <div>
            Bạn hãy nhập mật khẩu đang sử dụng và nhập mật khẩu mới 2 lần để chắc rằng bạn nhập
            đúng.
        </div>
        <div class="clr px10">
        </div>
        <p class="name">
            Tên truy cập:</p>
        
        <input name="cpUserName" type="text" maxlength="50" id="cpUserName" class="txt-info"
            value="">
        
        <div class="clr px10">
        </div>
        <p class="name">
            Mật khẩu cũ:</p>
        <input name="cpOldPassWord" type="password" maxlength="100" id="cpOldPassWord" class="txt-info">
        <div class="clr px10">
        </div>
        <p class="name">
            Mật khẩu mới:</p>
        <input name="cpNewPassword" type="password" maxlength="20" id="cpNewPassword" class="txt-info">
        <div class="clr px10">
        </div>
        Nhập lại:</p>
        <input name="cpNewPassword2" type="password" maxlength="20" id="cpNewPassword2" class="txt-info">
        </form>
    </div>
    <div id="fogetpass-dialog-form" title="Đăng nhập - Quên mật khẩu" style="display: none;">
        <form action="/" method="post" id="FrFogetPassword">
        <div>
            Bạn hãy nhập e-mail đã sử dụng để đăng ký thành viên.
        </div>
        <div class="clr px10">
        </div>
        <p class="name">
            E-mail:</p>
        <input name="cpEmail" type="text" maxlength="100" id="cpEmail" class="txt-info" />
        </form>
    </div>
